  Comp1_MainBlade_TrailingEdge06
  'Select sketches
  BoolStatus = Part.Extension.SelectByID2("[Impeller_1] MainBlade TrailingEdge Sketch00", "SKETCH", 0, 0, 0, False, 1, Nothing, 0)
  BoolStatus = Part.Extension.SelectByID2("[Impeller_1] MainBlade TrailingEdge Sketch01", "SKETCH", 0, 0, 0, True, 1, Nothing, 0)
  BoolStatus = Part.Extension.SelectByID2("[Impeller_1] MainBlade TrailingEdge Sketch02", "SKETCH", 0, 0, 0, True, 1, Nothing, 0)
  BoolStatus = Part.Extension.SelectByID2("[Impeller_1] MainBlade TrailingEdge Sketch03", "SKETCH", 0, 0, 0, True, 1, Nothing, 0)
  BoolStatus = Part.Extension.SelectByID2("[Impeller_1] MainBlade TrailingEdge Sketch04", "SKETCH", 0, 0, 0, True, 1, Nothing, 0)
  BoolStatus = Part.Extension.SelectByID2("[Impeller_1] MainBlade TrailingEdge Sketch05", "SKETCH", 0, 0, 0, True, 1, Nothing, 0)
  BoolStatus = Part.Extension.SelectByID2("[Impeller_1] MainBlade TrailingEdge Sketch06", "SKETCH", 0, 0, 0, True, 1, Nothing, 0)
  'Create lofted surface
  Part.InsertLoftRefSurface2 False, True, False, 1, 6, 6
  Set swFeature = SelMgr.GetSelectedObject(1)
  swFeature.Name = "[Impeller_1] MainBlade TrailingEdge"
  Part.ClearSelection2 True
End Sub

Sub Comp1_MainBlade()
  Comp1_MainBlade_LeadingEdge
  Comp1_MainBlade_SuctionSide
  Comp1_MainBlade_PressureSide
  Comp1_MainBlade_TrailingEdge
  'Blade rotation
  Dim lNum As Long
  lNum = 6
  BoolStatus = Part.Extension.SelectByID2("[Impeller_1] MainBlade LeadingEdge", "REFSURFACE", 0, 0, 0, False, 256, Nothing, 0)
  BoolStatus = Part.Extension.SelectByID2("[Impeller_1] MainBlade SuctionSide", "REFSURFACE", 0, 0, 0, True, 256, Nothing, 0)
  BoolStatus = Part.Extension.SelectByID2("[Impeller_1] MainBlade PressureSide", "REFSURFACE", 0, 0, 0, True, 256, Nothing, 0)
  BoolStatus = Part.Extension.SelectByID2("[Impeller_1] MainBlade TrailingEdge", "REFSURFACE", 0, 0, 0, True, 256, Nothing, 0)
  BoolStatus = Part.Extension.SelectByID2("z_Axis", "AXIS", 0, 0, 0, True, 1, Nothing, 0)
  Set swFeature = Part.FeatureManager.FeatureCircularPattern(lNum, 2# * 3.14159265 / lNum, False, "NULL")
  swFeature.Name = "[Impeller_1] MainBlade"
End Sub
'Main
'----------------------------------------------------------------------
Sub main()

  Const swDocPART = 1

  Dim vUnits       As Variant
  Dim Msg          As String
  Dim TemplatePath As String

  ' Connect to SolidWorks
  Set swApp = Application.SldWorks

  ' Use templatepath if known to circumvent crash after creation and show toolbars
  TemplatePath = swApp.GetDocumentTemplate(swDocPART, "", 0, 0#, 0#)

  ' Create new part
  If (Not (TemplatePath = "")) Then
    Set Part = swApp.NewDocument(TemplatePath, 0, 0, 0)
  Else
    Set Part = swApp.NewPart
  End If

  Set swModel = swApp.ActiveDoc

  ' disable graphics output to improve performance
  swModel.ActiveView.EnableGraphicsUpdate = False
  swModel.SetUnits 0, 1, 8, 2, False

  Set SelMgr = Part.SelectionManager()

  Set swSketchMgr = swModel.SketchManager

  Part.ActiveView.FrameState = 1

  Part.SetAddToDB true
  Part.SetDisplayWhenAdded false

'Rename default planes
  Dim PlaneCount As Long
  Set swFeature = Part.FirstFeature
  PlaneCount = 0
  Do While Not swFeature Is Nothing
    If swFeature.GetTypeName = "RefPlane" Then
      PlaneCount = PlaneCount + 1
      If PlaneCount = 1 Then
        swFeature.Name = "Plane_xy"
      End If
      If PlaneCount = 2 Then
        swFeature.Name = "Plane_xz"
      End If
      If PlaneCount = 3 Then
        swFeature.Name = "Plane_yz"
      End If
    End If
    Set swFeature = swFeature.GetNextFeature
  Loop

' Create z-axis
  BoolStatus = Part.Extension.SelectByID2("Plane_xz", "PLANE", 0, 0, 0, True, 0, Nothing, 0)
  BoolStatus = Part.Extension.SelectByID2("Plane_yz", "PLANE", 0, 0, 0, True, 0, Nothing, 0)
  Part.InsertAxis2 True
  Set swFeature = Part.FeatureByPositionReverse(0)
  swFeature.Name = "z_axis"

  Comp1_Hub
  Comp1_Shroud
  Comp1_MainBlade

  Part.ViewZoomtofit2
  Part.SetAddToDB False
  swModel.ActiveView.EnableGraphicsUpdate = true
End Sub
