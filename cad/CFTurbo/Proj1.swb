Sub Comp1_MainBlade_PressureSide()
  'Profile curves
  Comp1_MainBlade_PressureSide00
  Comp1_MainBlade_PressureSide01
  Comp1_MainBlade_PressureSide02
  Comp1_MainBlade_PressureSide03
  Comp1_MainBlade_PressureSide04
  Comp1_MainBlade_PressureSide05
  Comp1_MainBlade_PressureSide06
  'Select sketches
  BoolStatus = Part.Extension.SelectByID2("[Impeller_1] MainBlade PressureSide Sketch00", "SKETCH", 0, 0, 0, False, 1, Nothing, 0)
  BoolStatus = Part.Extension.SelectByID2("[Impeller_1] MainBlade PressureSide Sketch01", "SKETCH", 0, 0, 0, True, 1, Nothing, 0)
  BoolStatus = Part.Extension.SelectByID2("[Impeller_1] MainBlade PressureSide Sketch02", "SKETCH", 0, 0, 0, True, 1, Nothing, 0)
  BoolStatus = Part.Extension.SelectByID2("[Impeller_1] MainBlade PressureSide Sketch03", "SKETCH", 0, 0, 0, True, 1, Nothing, 0)
  BoolStatus = Part.Extension.SelectByID2("[Impeller_1] MainBlade PressureSide Sketch04", "SKETCH", 0, 0, 0, True, 1, Nothing, 0)
  BoolStatus = Part.Extension.SelectByID2("[Impeller_1] MainBlade PressureSide Sketch05", "SKETCH", 0, 0, 0, True, 1, Nothing, 0)
  BoolStatus = Part.Extension.SelectByID2("[Impeller_1] MainBlade PressureSide Sketch06", "SKETCH", 0, 0, 0, True, 1, Nothing, 0)
  'Create lofted surface
  Part.InsertLoftRefSurface2 False, True, False, 1, 6, 6
  Set swFeature = SelMgr.GetSelectedObject(1)
  swFeature.Name = "[Impeller_1] MainBlade PressureSide"
  Part.ClearSelection2 True
End Sub

